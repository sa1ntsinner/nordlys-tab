{
  "manifest_version": 3,
  "name": "Nordlys",
  "version": "2.5.2",
  "description": "Your favourite sites in folders on every new tab, over a sky that moves. Free, with no account and no tracking.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "omnibox": {
    "keyword": "nl"
  },
  "background": {
    "service_worker": "src/js/worker.js"
  },
  "action": {
    "default_title": "Save to Nordlys",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "favicon",
    "unlimitedStorage",
    "search",
    "activeTab",
    "contextMenus",
    "tabGroups"
  ],
  "optional_permissions": [
    "bookmarks",
    "tabs",
    "topSites",
    "history"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://api.todoist.com/*",
    "https://api.github.com/*",
    "https://*/*"
  ]
}

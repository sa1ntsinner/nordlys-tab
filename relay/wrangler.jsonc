{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nordlys-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "nordlys-sync", "database_id": "1b234d24-2bcb-461d-a4ea-397023d573d5" }
  ]
}
